# ---- Existing settings (unchanged) ----
CONTAINER_NAME=lol-tracker
APP_PORT=3081
BIND_IP=127.0.0.1
HOST_PORT=3081
SITE_URL=https://lolphabet.app
TRACKER_APP_DIR=/path/to/app
TRACKER_DATA_DIR=/path/to/data
COLLECTOR_DATA_DIR=/path/to/collector-data
CONTACT_EMAIL=

# ---- Login methods ----
# Comma separated, any of: Google, Discord, Password, Magic link
# ("Username and password" and "Email" also mean Password). Order = order shown in the login window.
LOGIN_TYPES="Google, Magic link, Password, Discord"

# Google (needed if Google is in LOGIN_TYPES)
GOOGLE_CLIENT_ID=xxxxxxxxx.apps.googleusercontent.com

# Discord (needed if Discord is in LOGIN_TYPES)
# Redirect to add in the Discord developer portal:  <SITE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email via Resend (needed if Password or Magic link is in LOGIN_TYPES)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM="LoLphabet <login@lolphabet.app>"     # must be on a domain verified in Resend
#MAIL_DAILY_LIMIT=90                            # Resend free plan: 100 a day
#MAIL_REPLY_TO=                                 # defaults to CONTACT_EMAIL
